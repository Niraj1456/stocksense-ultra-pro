PORT=3000
LOG_LEVEL=info

# Infra
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/stocksense
REDIS_URL=redis://localhost:6379

# Feature flags (hybrid mode)
ENABLE_CLAUDE=false

# Core Market Data: Angel One SmartAPI (Replaces NSE Scraping)
ANGEL_API_KEY=your_smartapi_key_here
ANGEL_CLIENT_ID=your_angel_client_id_here
ANGEL_PIN=your_angel_4_digit_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_for_auto_login

# Alternative Data: NLP Sentiment & Real-time Fundamentals
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
FMP_API_KEY=your_fmp_key

# Google Gemini (for AI Pre-Market Assistant)
GEMINI_API_KEY=

# Anthropic Claude (required when ENABLE_CLAUDE=true)
ANTHROPIC_API_KEY=

# Zerodha Kite Connect API
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=your_kite_access_token_here

# RBI DBIE (optional; depends on what series you choose)
RBI_DBIE_BASE=https://api.dbie.rbi.org.in/DBIE/dbie.rbi
RBI_DBIE_API_KEY=
